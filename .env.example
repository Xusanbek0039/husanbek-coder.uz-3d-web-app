# Bu faylni .env.local ga nusxalab, qiymatlarni to'ldiring.
# .env.local gitga TUSHMAYDI. Productionda shu o'zgaruvchilarni hosting sozlamalariga yozing.

# Kontakt formasi — email (Resend). https://resend.com/api-keys
RESEND_API_KEY=

# Kontakt/buyurtma formasi — Telegram xabarnoma
# Bot: @BotFather -> /newbot. Chat ID: botga /start yozib, https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bot webhooki uchun maxfiy so'z (A-Z, a-z, 0-9, _ va -). docs/telegram-bot.md
TELEGRAM_WEBHOOK_SECRET=

# Blog: itc-academy.uz API kaliti (= Django PORTFOLIO_API_KEY).
# Bo'lsa — post tagida kim like bosgani ham ko'rinadi. Bo'lmasa — faqat like soni va izohlar.
ITC_ACADEMY_API_KEY=
# Postlar ro'yxati API'si (ixtiyoriy, itc-academy.uz da hali yo'q). Bo'sh bo'lsa, sitemap.xml ishlatiladi.
ITC_ACADEMY_API_URL=
# itc-academy.uz post saqlanganda blog keshini darhol tozalash uchun maxfiy so'z.
# POST /api/revalidate/blog, sarlavha: X-Revalidate-Secret. docs/itc-academy-blog-api.md
BLOG_REVALIDATE_SECRET=

# YouTube videolari (Blog -> Videolar). docs/youtube-api.md
YOUTUBE_API_KEY=

# GitHub (ixtiyoriy) — rate limit va contribution grafigi uchun. Fine-grained, read-only token.
GITHUB_TOKEN=

# Realtime kursorlar/chat serveri (index.js). Bo'sh bo'lsa ulanmaydi.
NEXT_PUBLIC_WS_URL=

# Umami analytics (ixtiyoriy). Ikkalasi ham bo'lsa skript yuklanadi.
UMAMI_DOMAIN=
UMAMI_SITE_ID=
